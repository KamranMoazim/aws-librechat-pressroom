{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "CWAgent",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "disk": {
        "resources": ["/"],
        "measurement": ["used_percent"],
        "drop_device": true
      },
      "mem": {
        "measurement": ["used_percent"]
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/opt/pressroom/server/logs/*.log",
            "log_group_name": "/pressroom/librechat",
            "log_stream_name": "{instance_id}/{file_name}",
            "retention_in_days": 90
          },
          {
            "file_path": "/var/lib/docker/containers/*/*-json.log",
            "log_group_name": "/pressroom/containers",
            "log_stream_name": "{instance_id}/{file_name}",
            "retention_in_days": 30
          }
        ]
      }
    }
  }
}
