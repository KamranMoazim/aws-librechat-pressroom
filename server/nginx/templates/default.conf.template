map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server_tokens off;

map $cookie_pressroom_return $pressroom_after_login {
    default https://chat.pressroom.${DOMAIN};
    portal  https://portal.pressroom.${DOMAIN}/;
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name chat.pressroom.${DOMAIN};
    include /etc/nginx/conf.d/tls.inc;
    add_header Content-Security-Policy "frame-ancestors 'self' https://portal.pressroom.${DOMAIN}" always;

    client_max_body_size 25M;

    location / {
        include /etc/nginx/conf.d/chat-proxy.inc;
    }

    # A location with its own add_header drops the server-level ones, so each repeats HSTS and framing.
    location = /oauth/openid/callback {
        include /etc/nginx/conf.d/chat-proxy.inc;
        proxy_redirect ~^https://chat\.pressroom\.${DOMAIN}/?$ $pressroom_after_login;
        add_header Set-Cookie "pressroom_return=; Path=/oauth; Max-Age=0; Secure; HttpOnly; SameSite=Lax" always;
        add_header Strict-Transport-Security "max-age=63072000" always;
        add_header Content-Security-Policy "frame-ancestors 'self' https://portal.pressroom.${DOMAIN}" always;
    }

    location = /pressroom/signin {
        add_header Set-Cookie "pressroom_return=portal; Path=/oauth; Max-Age=120; Secure; HttpOnly; SameSite=Lax" always;
        add_header Strict-Transport-Security "max-age=63072000" always;
        return 302 /oauth/openid;
    }

    location ^~ /pressroom/ {
        alias /usr/share/nginx/pressroom/;
        add_header Content-Security-Policy "default-src 'none'; script-src 'self'; connect-src 'self'; frame-ancestors https://portal.pressroom.${DOMAIN}" always;
        add_header Strict-Transport-Security "max-age=63072000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control no-store always;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name portal.pressroom.${DOMAIN};
    include /etc/nginx/conf.d/tls.inc;

    resolver 127.0.0.11 valid=30s;
    set $portal_upstream http://portal:3000;

    location / {
        proxy_pass $portal_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name admin.pressroom.${DOMAIN};
    include /etc/nginx/conf.d/tls.inc;

    client_max_body_size 25M;

    resolver 127.0.0.11 valid=30s;
    set $admin_panel_upstream http://admin-panel:3000;

    location / {
        proxy_pass $admin_panel_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name bundler.pressroom.${DOMAIN};
    include /etc/nginx/conf.d/tls.inc;

    resolver 127.0.0.11 valid=30s;
    set $bundler_upstream http://sandpack-bundler:80;

    location / {
        proxy_pass $bundler_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
