DOMAIN=${DOMAIN}
ACME_EMAIL=${ACME_EMAIL}
HOST=0.0.0.0
PORT=3080
DOMAIN_CLIENT=https://chat.pressroom.${DOMAIN}
DOMAIN_SERVER=https://chat.pressroom.${DOMAIN}
NO_INDEX=true
TRUST_PROXY=1
CONSOLE_JSON=false
DEBUG_LOGGING=false
DEBUG_CONSOLE=false
DEBUG_OPENAI=false

CREDS_KEY=${CREDS_KEY}
CREDS_IV=${CREDS_IV}
JWT_SECRET=${JWT_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}

MONGO_ROOT_PASSWORD=${MONGO_ROOT_PASSWORD}
MONGO_APP_PASSWORD=${MONGO_APP_PASSWORD}

SEARCH=true
MEILI_NO_ANALYTICS=true
MEILI_ENV=production
MEILI_MASTER_KEY=${MEILI_MASTER_KEY}

POSTGRES_DB=librechat_vectors
POSTGRES_USER=librechat
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5
OPENAI_API_KEY=${OPENAI_API_KEY}
OPENAI_MODELS=gpt-6-sol
XAI_API_KEY=${XAI_API_KEY}
RAG_OPENAI_API_KEY=${OPENAI_API_KEY}
EMBEDDINGS_PROVIDER=openai
EMBEDDINGS_MODEL=text-embedding-3-small

ADMIN_PANEL_SESSION_SECRET=${ADMIN_PANEL_SESSION_SECRET}
ADMIN_PANEL_SESSION_COOKIE_SECURE=true

SANDPACK_BUNDLER_URL=https://bundler.pressroom.${DOMAIN}

ENABLE_SHAREPOINT_FILEPICKER=true
SHAREPOINT_BASE_URL=https://${SHAREPOINT_TENANT}.sharepoint.com
SHAREPOINT_PICKER_SHAREPOINT_SCOPE=https://${SHAREPOINT_TENANT}.sharepoint.com/AllSites.Read
SHAREPOINT_PICKER_GRAPH_SCOPE=Files.Read.All
CSP_FRAME_SRC_EXTRA=https://${SHAREPOINT_TENANT}.sharepoint.com

MCP_CLIENT_ID=${MCP_CLIENT_ID}
MCP_CLIENT_SECRET=${MCP_CLIENT_SECRET}
ENTRA_TENANT_ID=${ENTRA_TENANT_ID}
PACE_API_KEY=${PACE_API_KEY}
AUDIT_ADMIN_PASSWORD=${AUDIT_ADMIN_PASSWORD}
AUDIT_WRITER_PASSWORD=${AUDIT_WRITER_PASSWORD}

ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=true
ALLOW_PASSWORD_RESET=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=false
ALLOW_SHARED_LINKS=true
ALLOW_SHARED_LINKS_PUBLIC=false

OPENID_ISSUER=https://login.microsoftonline.com/${ENTRA_TENANT_ID}/v2.0
OPENID_CLIENT_ID=${OPENID_CLIENT_ID}
OPENID_CLIENT_SECRET=${OPENID_CLIENT_SECRET}
OPENID_SESSION_SECRET=${OPENID_SESSION_SECRET}
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_SCOPE="openid profile email offline_access api://${OPENID_CLIENT_ID}/access_as_user"
OPENID_BUTTON_LABEL="Sign in with Microsoft"
OPENID_REUSE_TOKENS=true
OPENID_ON_BEHALF_FLOW_FOR_USERINFO_REQUIRED=true
OPENID_ON_BEHALF_FLOW_USERINFO_SCOPE=user.read
OPENID_REQUIRED_ROLE=LibreChat.User
OPENID_REQUIRED_ROLE_TOKEN_KIND=id
OPENID_REQUIRED_ROLE_PARAMETER_PATH=roles
OPENID_ADMIN_ROLE=LibreChat.Admin
OPENID_ADMIN_ROLE_TOKEN_KIND=id
OPENID_ADMIN_ROLE_PARAMETER_PATH=roles
OPENID_USE_END_SESSION_ENDPOINT=true
