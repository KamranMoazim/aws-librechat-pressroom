{
  "name": "pressroom-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run test:auth && npm run test:outlook && npm run test:pace && npm run test:http && npm run test:runner && npm run test:relevance && npm run test:voice",
    "test:auth": "tsx test/auth.test.ts",
    "test:outlook": "tsx test/outlook.test.ts",
    "test:http": "tsx test/http.test.ts",
    "dev:outlook": "tsx watch src/outlook/main.ts",
    "test:pace": "tsx test/pace.test.ts",
    "dev:pace": "tsx watch src/pace/main.ts",
    "pace:permissions": "tsx scripts/pace-permissions.ts",
    "test:runner": "tsx test/runner.test.ts",
    "check:recorder": "tsx scripts/check-recorder.ts",
    "test:relevance": "tsx test/relevance.test.ts",
    "dev:relevance": "tsx watch src/relevance/main.ts",
    "test:voice": "tsx test/voice.test.ts",
    "dev:voice": "tsx watch src/voice/main.ts"
  },
  "dependencies": {
    "@azure/msal-node": "^7.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  }
}
