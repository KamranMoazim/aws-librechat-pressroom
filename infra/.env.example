# Public Route 53 zone you own; internal names live under pressroom.<DOMAIN>
DOMAIN=example.com
# Hosted zone ID of DOMAIN, used only for Let's Encrypt DNS-01 TXT records
PUBLIC_ZONE_ID=Z0123456789ABCDEFGHIJ
# Receives budget alerts
ALERT_EMAIL=you@example.com
# From infra/scripts/vpn-cert.sh; leave empty until you set up the VPN
VPN_SERVER_CERT_ARN=
# Object ID of the Entra group allowed on the VPN
VPN_ENTRA_GROUP_ID=
# Entra tenant and the PressRoom-LibreChat app registration (docs/entra-setup.md)
ENTRA_TENANT_ID=
OPENID_CLIENT_ID=
