{
  "name": "aws-librechat-pressroom",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "install:all": "npm --prefix infra install",
    "typecheck": "npm --prefix infra run typecheck",
    "infra:test": "npm --prefix infra test",
    "server:test": "server/test/render-env.test.sh",
    "infra:synth": "npm --prefix infra run synth",
    "format": "npx prettier@3.6.2 --write infra/bin infra/lib infra/test server/librechat.yaml server/docker-compose.override.yml",
    "secrets": "infra/scripts/set-secrets.sh",
    "vpn:cert": "infra/scripts/vpn-cert.sh",
    "registries": "infra/scripts/registries.sh",
    "session:up": "infra/scripts/session-up.sh",
    "push-server": "infra/scripts/push-server.sh",
    "pause": "infra/scripts/pause.sh",
    "teardown": "infra/scripts/teardown.sh"
  }
}
