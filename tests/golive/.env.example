# Same values as infra/.env
DOMAIN=example.com
ENTRA_TENANT_ID=
MCP_CLIENT_ID=
SHAREPOINT_TENANT=
# PressRoom-GoLive app registration (public client, docs/entra-setup.md); remove its consent after go-live
GOLIVE_CLIENT_ID=
# SharePoint site that only estimators can open, and Pace jobs for the permission matrix
ESTIMATING_SITE=/sites/Estimating
OPEN_JOB=J24017
RESTRICTED_JOB=J24011
# A Relevance agent on the allowlist, used for the key-rotation check
RELEVANCE_TEST_AGENT=
AWS_REGION=us-east-1
